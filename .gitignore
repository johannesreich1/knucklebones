node_modules/
*.zip
# JetBrains IDE project metadata is local workspace state.
.idea/
# The native shell: the Capacitor config and the Xcode project ARE source (they
# carry the bundle id and signing setup, and cannot be regenerated identically).
# Everything a tool re-creates is not.
# (gitignore has no trailing comments — a "pattern # note" line matches nothing)
native/node_modules/
# build.mjs writes it from dist/main
native/www/
# cap sync copies www in here
native/ios/App/App/public/
# pod install rebuilds these; Podfile.lock IS committed
native/ios/App/Pods/
native/ios/App/build/
native/ios/DerivedData/
native/android/.gradle/
native/android/build/
native/android/app/build/
native/android/local.properties
# tools/appicon.mjs and tools/splash.mjs recreate the temporary custom-mode
# inputs; @capacitor/assets turns them into tracked Android res/ compiler input.
native/assets/
# Release credentials stay owner-local. CI intentionally builds unsigned.
keystore.properties
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.ipa
*.mobileprovision
*.provisionprofile
*.xcarchive/
*.xcuserdatad/
xcuserdata/
.bundle/
vendor/bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots.html
fastlane/README.md
fastlane/test_output/
# agent skills: content restored via `npx skills add` + skills-lock.json
.agents/
.claude/skills/
# generated by build.mjs — src/ is the only source of truth
dist/
pwa/
knucklebones-neon.html
widget.html
harness.html
# test artifacts
# run-all holds this while a gate runs — one gate at a time per working tree
.gate.lock
# gate screenshots — every suite writes through tests/shot.mjs
tests/screens/
.env
.env.*
!.env.example
!.env.live.example
!.env.appstore.example
design/dist/
