{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    /* Strict everywhere. The moved-verbatim flow/ui modules still carry
       file-level @ts-nocheck headers — removing those (and typing the file)
       is the remaining ratchet; never add a new nocheck. */
    "strict": true
  },
  "include": ["src"]
}
