{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    /* Loose during the migration out of app.ts (which is ts-nocheck anyway).
       The ratchet: as modules are extracted in milestone B they are written
       clean, and strictness turns ON here the moment app.ts is dissolved. */
    "strict": false
  },
  "include": ["src"]
}
