{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    /* Strict everywhere; the @ts-nocheck ratchet completed and
       tests/architecture.test.ts rejects any new one. noUnusedLocals keeps
       dead imports and locals from accumulating silently again. */
    "strict": true,
    "noUnusedLocals": true
  },
  "include": ["src"]
}
