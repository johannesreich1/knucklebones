# Copy to .env.appstore. Keep the .p8 key outside this repository.
ASC_KEY_ID=
# Team keys require an issuer id; leave empty for an individual key.
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/outside/knucklebones/AuthKey_KEYID.p8
ASC_APP_VERSION=1.0
# Must exactly match an existing English localization in App Store Connect.
ASC_SCREENSHOT_LOCALE=en-US
# Paste the inventory-bound value printed by the read-only plan lane.
ASC_SCREENSHOT_UPLOAD_CONFIRM=
# Optional escape hatch; normally mise supplies the repository's Node 24.
# KB_NODE_BINARY=/absolute/path/to/node
