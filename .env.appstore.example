# Copy to .env.appstore. Keep the .p8 key outside this repository.
ASC_KEY_ID=
# Team keys require an issuer id; leave empty for an individual key.
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/outside/knucklebones/AuthKey_KEYID.p8
ASC_APP_VERSION=1.0
# Locales and screenshot targets come from the reviewed repository contract:
# en-GB/de-DE/fr-FR x iPhone 6.9-inch/iPad 13-inch. Do not select one here.
# Paste the desired-and-remote-inventory-bound token from the read-only plan.
ASC_APP_STORE_SYNC_CONFIRM=
