<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Configured for the App target's Debug and Release configurations. The owner
	     confirmed both capabilities on com.appavaria.knucklebones in the Apple
	     Developer portal on 2026-08-25; the iOS shipping contract keeps this
	     payload and both CODE_SIGN_ENTITLEMENTS settings in sync. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
