<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple: the one-tap rung of the identity ladder (see
	     src/online/identity.ts). Both capabilities below must ALSO be enabled
	     on the App ID in the developer portal, which needs a paid Developer
	     Program membership — a free personal team cannot sign this file. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Game Center: identity that survives a reinstall with no taps at all. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
